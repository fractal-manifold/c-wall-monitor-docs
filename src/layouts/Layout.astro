---
import '../styles/global.css';
import BgStage from '../components/BgStage.astro';
import AnnounceBar from '../components/AnnounceBar.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LegalFooter from '../components/LegalFooter.astro';
import RedditPixel from '../components/RedditPixel.astro';
import { SITE, ANNOUNCE_KEY } from '../consts';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';

/* Content hash for /assets/device-screens.js.
 *
 * The file lives in public/, so Astro copies it through verbatim — no
 * fingerprint in the name — and GitHub Pages serves it with
 * `cache-control: max-age=14400`. A deploy therefore publishes new HTML
 * against up to four hours of stale JS. That is not theoretical: the deploy
 * that fixed a SyntaxError in this very file left the live site still broken,
 * because the edge kept handing out the broken copy while the new HTML went
 * out immediately.
 *
 * Hashing the contents into a query string makes the URL change exactly when
 * the file does, so the edge is forced to refetch on the deploy that matters
 * and keeps caching aggressively the rest of the time. Read at build time
 * only — this runs in the Astro frontmatter, never in the browser. */
const deviceScreensSrc = (() => {
  const bytes = readFileSync(new URL('../../public/assets/device-screens.js', import.meta.url));
  return `/assets/device-screens.js?v=${createHash('sha256').update(bytes).digest('hex').slice(0, 12)}`;
})();

const {
  title,
  description,
  page,
  canonical,
  ogImage = '/assets/lead.jpg',
  ogDescription = description,
  ogAlt = 'TokenMonitor — 4-inch desk display showing live AI usage',
  usesDeviceScreens = false,
  noindex = false,
  legal = true,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE).href;
const ogImageUrl = new URL(ogImage, SITE).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{title}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="TokenMonitor" />
  <meta property="og:locale" content="en_US" />
  {!noindex && <meta property="og:url" content={canonicalUrl} />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="1200" />
  <meta property="og:image:alt" content={ogAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={ogDescription} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={ogAlt} />
  <link rel="icon" type="image/png" href="/assets/logo.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/logo.png" />
  <meta name="theme-color" content="#0b0b0d" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#f8f8f8" media="(prefers-color-scheme: light)" />
  {/* Anti-FOUC theme + announce-bar bootstrap — must stay inline &
      render-blocking in <head>. The announce flag also drives --announce-h,
      so applying it here keeps a dismissed bar from flashing and the chrome
      offset from shifting after first paint. */}
  <script is:inline define:vars={{ announceKey: ANNOUNCE_KEY }}>try{var t=localStorage.getItem('tmon:theme');document.documentElement.dataset.theme=(t==='dark')?'dark':'light';}catch(e){document.documentElement.dataset.theme='light';}try{if(localStorage.getItem(announceKey)==='dismissed'){document.documentElement.dataset.announce='off';}}catch(e){}</script>
  <RedditPixel />
</head>
<body data-page={page}>
  <BgStage />
  <AnnounceBar />
  <Header page={page} />
  <main>
    <slot />
  </main>
  {legal && <LegalFooter />}
  <SiteFooter />
  {usesDeviceScreens && <script is:inline src={deviceScreensSrc}></script>}
</body>
</html>
